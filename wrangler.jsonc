{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cupiniran-games",
  "main": "main.js",
  "compatibility_date": "2026-09-15",
  "migrations": [
    {
      "new_sqlite_classes": [
        "GameRoom"
      ],
      "tag": "v1"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "class_name": "GameRoom",
        "name": "GAME_ROOMS"
      }
    ]
  },
  "observability": {
    "enabled": true
  }
}
