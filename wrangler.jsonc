{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cupiniran-games",
  "main": "main.js",
  "compatibility_date": "2026-09-15",

  "durable_objects": {
    "bindings": [
      {
        "name": "GAME_ROOMS",
        "class_name": "GameRoom"
      }
    ]
  },

  "exports": {
    "GameRoom": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
